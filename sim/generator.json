{
  "mercy_fill": 0.55,
  "mercy_rerolls": 2,
  "rescue_lines": 3,
  "families": {
    "dot":     {"weight": 2, "art": ["X"]},
    "line2":   {"weight": 4, "art": ["XX"]},
    "line3":   {"weight": 5, "art": ["XXX"]},
    "line4":   {"weight": 4, "art": ["XXXX"]},
    "line5":   {"weight": 2, "art": ["XXXXX"]},
    "sq2":     {"weight": 5, "art": ["XX", "XX"]},
    "sq3":     {"weight": 2, "art": ["XXX", "XXX", "XXX"]},
    "rect23":  {"weight": 3, "art": ["XXX", "XXX"]},
    "corner3": {"weight": 5, "art": ["XX", "X."]},
    "corner5": {"weight": 2, "art": ["XXX", "X..", "X.."]},
    "L4":      {"weight": 5, "art": ["X.", "X.", "XX"]},
    "T4":      {"weight": 3, "art": ["XXX", ".X."]},
    "S4":      {"weight": 3, "art": [".XX", "XX."]},
