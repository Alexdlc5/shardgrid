    "rescue_time": 20, "warn": 0.25,
    "bot_seconds": {"random": [2, 0.7], "greedy": [3, 1], "lookahead": [4.5, 1.5]},
    "target": {"bot": "greedy", "biome": "hollow", "p50_s": [180, 300]}
  },
  "biomes": {
    "hollow": {"drain": 1, "types": {"moss": 5, "jade": 3, "amber": 2}},
    "ember":  {"drain": 1.15, "types": {"moss": 2, "jade": 2, "amber": 2, "garnet": 2, "ember": 1.3},
               "families": {"flame": {"weight": 2, "art": [".X.", "XXX", ".X."]}}}
  },
  "target": {
    "bot": "greedy",
    "p50": [60, 120],
    "p90_max": 350,
    "first_tray_max": 0.02,
    "lookahead_p50_ratio_min": 1.5
