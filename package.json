{
  "name": "glimmerwood",
  "private": true,
  "version": "0.1.0",
  "description": "Glimmerwood: a forest crystal-mining block puzzle (Capacitor app around proto/)",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "check": "node proto/check.mjs && node scripts/check-save-mirror.mjs && python sim/test_sim.py",
    "check:story": "npm run build && node scripts/scene-check.mjs",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "assets": "node scripts/app-art.mjs",
    "test:screens": "node scripts/crisp.mjs --check 2 && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor-firebase/crashlytics": "^8.5.2",
    "@capacitor-firebase/remote-config": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/grandstander": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@resvg/resvg-js": "^2.6.2",
    "playwright": "^1.56.1",
    "puppeteer-core": "^25.14.0"
  }
}
